<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Softcode\Gls\Api\RecipientResolverInterface"
                type="Softcode\Gls\Model\Label\DefaultRecipientResolver"/>

    <!-- Add project rules here from your own module, e.g.
         <item name="courses" xsi:type="object">Vendor\Module\Model\CourseShippingRule</item> -->
    <type name="Softcode\Gls\Model\Shippability">
        <arguments>
            <argument name="rules" xsi:type="array">
                <item name="product_type" xsi:type="object">Softcode\Gls\Model\ShippingRule\ProductTypeRule</item>
                <item name="excluded_sku" xsi:type="object">Softcode\Gls\Model\ShippingRule\ExcludedSkuRule</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Quote\Model\Quote\Address\Total\Collector">
        <arguments>
            <argument name="calculators" xsi:type="array">
                <item name="gls_shipping" xsi:type="string">Softcode\Gls\Model\Quote\Address\Total\GlsShipping</item>
            </argument>
        </arguments>
    </type>
</config>
