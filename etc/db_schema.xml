        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="quote">
        <column xsi:type="varchar" name="gls_method" length="64" nullable="true" comment="GLS Delivery Method"/>
        <column xsi:type="varchar" name="gls_shop_id" length="64" nullable="true" comment="GLS Shop ID"/>
