<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <shipping>
            <gls>
                <enabled>0</enabled>
                <password backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <max_parcel_weight>15</max_parcel_weight>
                <ship_on_invoice>0</ship_on_invoice>
            </gls>
        </shipping>
        <carriers>
            <softcode_gls>
                <active>1</active>
                <title>GLS</title>
                <name>GLS</name>
                <model>Softcode\Gls\Model\Carrier\Gls</model>
            </softcode_gls>
        </carriers>
    </default>
</config>
