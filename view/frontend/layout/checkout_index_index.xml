<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <script src="Softcode_Gls::js/gls-checkout.js"/>
    </head>
    <body>
        <!-- Render config BEFORE JS executes -->
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   name="softcode.gls.config"
                   template="Softcode_Gls::config.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Softcode\Gls\ViewModel\Config</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
